          "schema_version": 0,
          "attributes": {
            "arn": "arn:aws:cloudfront::694710432912:function/website-IndexHandler",
            "code": "function handler(event) {\n    var request = event.request;\n    var uri = request.uri;\n\n    // Check whether the URI is missing a file name.\n    if (uri.endsWith('/')) {\n        console.log('Redirected '+uri+' as end folder')\n        request.uri += 'index.html';\n    }\n\n    return request;\n}\n",
            "comment": "website-IndexHandler",
            "etag": "E1F83G8C2ARO7P",
